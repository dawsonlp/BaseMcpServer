# WorldContext MCP Server Configuration

server:
  name: "worldcontext"
  host: "localhost"
  port: 7501
  api_key: "example_key"
  # Required when host is not loopback:
  # allowed_hosts: ["mcp.example.com"]
  # allowed_origins: ["https://client.example.com"]

api_keys:
  alphavantage: "YOUR_ALPHAVANTAGE_API_KEY_HERE"
  newsapi: "YOUR_NEWSAPI_KEY_HERE"
